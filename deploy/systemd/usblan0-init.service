[Unit]
Description=PisoWiFi usblan0 Static IP Initializer
DefaultDependencies=no
After=network-pre.target systemd-udevd.service
Before=network.target dnsmasq.service pisowifi.service
Wants=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=60
ExecStart=/bin/bash -c '\
  echo "[usblan0-init] Waiting for usblan0 interface..."; \
  for i in $(seq 1 45); do \
    if ! ip link show usblan0 >/dev/null 2>&1; then \
      USB_IF=$(ls -d /sys/bus/usb/devices/*/net/* 2>/dev/null | head -n1 | xargs -n1 basename 2>/dev/null || true); \
      if [ -n "$USB_IF" ] && [ "$USB_IF" != "usblan0" ]; then \
        echo "[usblan0-init] Detected USB network interface $USB_IF, renaming to usblan0..."; \
        ip link set "$USB_IF" down 2>/dev/null || true; \
        ip link set "$USB_IF" name usblan0 2>/dev/null || true; \
      fi; \
    fi; \
    if ip link show usblan0 >/dev/null 2>&1; then \
      echo "[usblan0-init] usblan0 detected, assigning 10.10.10.1/24..."; \
      ip link set usblan0 up; \
      ip addr replace 10.10.10.1/24 dev usblan0; \
      systemctl --no-block try-restart dnsmasq; \
      exit 0; \
    fi; \
    if [ "$i" -eq 4 ] && command -v usb_modeswitch >/dev/null 2>&1; then \
      echo "[usblan0-init] Triggering modeswitch on 30ae:3300..."; \
      usb_modeswitch -v 30ae -p 3300 -K 2>/dev/null || true; \
    fi; \
    sleep 1; \
  done; \
  echo "[usblan0-init] WARNING: usblan0 not detected after 45s" >&2; \
  exit 0 \
'

[Install]
WantedBy=multi-user.target
